---
import Base from '../layouts/Base.astro';
import { site, publications } from '../../site.config';

const title = '论文';

const byYear = [...publications]
  .sort((a, b) => b.year - a.year)
  .reduce<Record<number, typeof publications>>((acc, p) => {
    (acc[p.year] ||= []).push(p);
    return acc;
  }, {});

const years = Object.keys(byYear)
  .map(Number)
  .sort((a, b) => b - a);
---

<Base title={title} description={`${site.name} 的论文与 preprint 列表`}>
  <section class="section">
    <h1 class="page-title">{title}</h1>
    <p class="page-sub">
      在 <code>site.config.ts</code> 的 <code>publications</code> 里增删条目即可。
    </p>
  </section>

  <hr class="divider" style="margin:28px 0 0" />

  {
    years.length === 0 ? (
      <section class="section">
        <div class="empty">还没有条目。把示例注释打开，或按同样格式添加你自己的论文。</div>
      </section>
    ) : (
      years.map((y) => (
        <section class="section">
          <div class="section-head">
            <h2>{y}</h2>
          </div>
          <div class="list">
            {byYear[y].map((p) => (
              <div class="item">
                <div class="item-title">{p.title}</div>
                <div class="item-sub">
                  {p.authors.join(', ')} · <em>{p.venue}</em>
                  {p.type && <span class="tag" style="margin-left:8px">{p.type}</span>}
                </div>
                {p.note && <div class="item-desc">{p.note}</div>}
                {p.links && p.links.length > 0 && (
                  <div class="item-meta">
                    {p.links.map((l) => (
                      <a href={l.href} target="_blank" rel="noopener">{l.label}</a>
                    ))}
                  </div>
                )}
              </div>
            ))}
          </div>
        </section>
      ))
    )
  }
</Base>
