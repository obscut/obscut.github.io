---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { site, intro, links, research, leetcode as lcCfg } from '../../site.config';
import { getLeetCodeData } from '../lib/leetcode';
import { fmtDate } from '../lib/format';

const posts = (await getCollection('blog'))
  .filter((p) => (import.meta.env.PROD ? !p.data.draft : true))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const lc = await getLeetCodeData();
const lcProfile = `https://leetcode.com/u/${lc.username}/`;
---

<Base>
  <!-- 首屏 -->
  <section class="section">
    <h1 class="hero-name">{site.name}</h1>
    <div class="hero-role">{site.role} · {site.affiliation}</div>
    <div class="hero-meta">{site.location}</div>

    <div class="link-row">
      {site.email && <a href={`mailto:${site.email}`}>{site.email}</a>}
      {links.map((l) => <a href={l.href} target="_blank" rel="noopener">{l.label}</a>)}
    </div>
  </section>

  <!-- 关于 -->
  <section class="section">
    <div class="section-head"><h2>About</h2></div>
    {intro.map((p) => <p>{p}</p>)}
  </section>

  <!-- 研究方向 -->
  <section class="section">
    <div class="section-head">
      <h2>Research</h2>
      <a class="more" href="/research/">全部 →</a>
    </div>
    <div class="grid">
      {
        research.map((r) => (
          <div class="card">
            <div class="card-title">{r.title}</div>
            <p class="card-desc">{r.summary}</p>
            <div class="card-meta">
              {r.tags.map((t) => (
                <span class="tag">{t}</span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- 最新文章 -->
  <section class="section">
    <div class="section-head">
      <h2>Writing</h2>
      <a class="more" href="/blog/">全部 →</a>
    </div>
    {
      posts.length === 0 ? (
        <div class="empty">还没有文章。在 src/content/blog/ 下新建 .md 文件即可。</div>
      ) : (
        <div class="list">
          {posts.map((p) => (
            <a class="item" href={`/blog/${p.id}/`}>
              <div class="item-title">{p.data.title}</div>
              {p.data.summary && <div class="item-desc">{p.data.summary}</div>}
              <div class="item-meta">
                <span>{fmtDate(p.data.date)}</span>
                {p.data.tags.map((t) => (
                  <span class="tag">{t}</span>
                ))}
              </div>
            </a>
          ))}
        </div>
      )
    }
  </section>

  <!-- 刷题 -->
  <section class="section">
    <div class="section-head">
      <h2>LeetCode</h2>
      <a class="more" href="/leetcode/">详情 →</a>
    </div>
    <div class="stats">
      <div>
        <div class="stat-value">{lc.total}</div>
        <div class="stat-label">已解决</div>
      </div>
      <div>
        <div class="stat-value">{lc.easy}</div>
        <div class="stat-label">简单</div>
      </div>
      <div>
        <div class="stat-value">{lc.medium}</div>
        <div class="stat-label">中等</div>
      </div>
      <div>
        <div class="stat-value">{lc.hard}</div>
        <div class="stat-label">困难</div>
      </div>
    </div>
    {
      !lc.ok && (
        <p class="small subtle" style="margin-top:14px">
          数据为兜底值（构建时未能连上 LeetCode）。可在 <code>site.config.ts</code> 的
          <code>leetcode.fallback</code> 里手动填写，或确认用户名 <code>{lcCfg.username}</code> 是否正确。
        </p>
      )
    }
    <p class="small" style="margin-top:14px">
      <a href={lcProfile} target="_blank" rel="noopener">前往 LeetCode 主页 →</a>
    </p>
  </section>
</Base>
